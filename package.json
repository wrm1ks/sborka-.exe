
{
  "name": "chitalka-desktop",
  "version": "1.0.0",
  "description": "Читалка для Windows 7 32-bit",
  "main": "main.cjs",
  "author": "Chitalka",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --ia32"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "22.14.13"
  },
  "build": {
    "appId": "ru.reader.chitalka",
    "productName": "Chitalka",
    "asar": true,
    "files": [
      "main.cjs",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "ia32"
          ]
        }
      ],
      "artifactName": "Chitalka-Windows-7-32bit.${ext}"
    }
  }
}
